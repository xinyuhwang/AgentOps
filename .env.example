# Matches docker-compose.yml (host port 5433 to avoid colliding with a local Postgres).
DATABASE_URL=postgres://agentops:agentops@localhost:5433/agentops

# Optional. Without it the run engine uses the deterministic scripted provider,
# which is enough to exercise the state machine end to end without spending money.
ANTHROPIC_API_KEY=

# anthropic | fake
LLM_PROVIDER=fake

# How many runs one organization may have executing concurrently (§7.8).
MAX_CONCURRENT_RUNS_PER_ORG=3
